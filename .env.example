# Optional. The play night tool normally runs on the host's phone behind the footer door and a code,
# with no server. To switch on the cloud sign-in version instead (Supabase, see supabase/play-schema.sql),
# set all three at build time:
PUBLIC_PLAY_CLOUD=on
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
