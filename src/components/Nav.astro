---
const { pathname } = Astro.url;

type NavLink =
  | { href: string; label: string }
  | { label: string; children: { href: string; label: string }[] };

const links: NavLink[] = [
  { href: '/', label: 'Home' },
  { href: '/sessions', label: 'Sessions' },
  { href: '/join', label: 'Join us' },
  {
    label: 'Learn',
    children: [
      { href: '/rules', label: 'Pickleball in 5 minutes' },
      { href: '/code-of-conduct', label: 'Conduct & etiquette' },
    ],
  },
  { href: '/news', label: 'News' },
  { href: '/about', label: 'About' },
  { href: '/merch', label: 'Merch' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const learnActive = pathname.startsWith('/rules') || pathname.startsWith('/code-of-conduct');
---

<header class="site-header">
  <div class="container nav-wrap">
    <a href="/" class="brand">
      <img src="/img/logo.png" alt="" class="brand-mark" width="48" height="48" />
      <span class="brand-text">
        <strong>First &amp; Last</strong>
        <small>Pickleball Club · St Just</small>
      </span>
    </a>

    <button
      type="button"
      class="hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="primary-nav" aria-label="Primary">
      <ul>
        {links.map((l) =>
          'children' in l ? (
            <li class="has-dropdown">
              <button
                type="button"
                aria-expanded="false"
                aria-haspopup="true"
                class={learnActive ? 'active' : ''}
              >
                {l.label}
                <span class="caret" aria-hidden="true">▾</span>
              </button>
              <ul class="dropdown" role="menu">
                {l.children.map((c) => (
                  <li role="none">
                    <a href={c.href} role="menuitem" class={isActive(c.href) ? 'active' : ''}>
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.label}</a>
            </li>
          )
        )}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Dropdown toggle (Learn menu)
  const dropdownTriggers =
    document.querySelectorAll<HTMLButtonElement>('.has-dropdown > button');

  function closeAllDropdowns(except?: HTMLButtonElement) {
    document
      .querySelectorAll<HTMLButtonElement>('.has-dropdown > button[aria-expanded="true"]')
      .forEach((b) => {
        if (b !== except) b.setAttribute('aria-expanded', 'false');
      });
  }

  dropdownTriggers.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      closeAllDropdowns(btn);
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
    });
  });

  // Hamburger toggle (mobile)
  const hamburger = document.querySelector<HTMLButtonElement>('.hamburger');
  const header = document.querySelector<HTMLElement>('.site-header');

  hamburger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = hamburger.getAttribute('aria-expanded') === 'true';
    hamburger.setAttribute('aria-expanded', open ? 'false' : 'true');
    hamburger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    header?.classList.toggle('menu-open', !open);
    if (open) closeAllDropdowns();
  });

  // Close everything on outside click or Escape
  document.addEventListener('click', () => {
    closeAllDropdowns();
    if (hamburger?.getAttribute('aria-expanded') === 'true') {
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.setAttribute('aria-label', 'Open menu');
      header?.classList.remove('menu-open');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAllDropdowns();
      if (hamburger?.getAttribute('aria-expanded') === 'true') {
        hamburger.setAttribute('aria-expanded', 'false');
        hamburger.setAttribute('aria-label', 'Open menu');
        header?.classList.remove('menu-open');
      }
    }
  });

  // Don't close the menu when clicking inside it
  document.querySelector('#primary-nav')?.addEventListener('click', (e) => {
    e.stopPropagation();
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(180%) blur(8px);
    background: rgba(251, 250, 246, 0.85);
  }
  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--sea-dark);
  }
  .brand-mark {
    width: 48px;
    height: 48px;
    object-fit: contain;
    object-position: center;
    display: block;
    flex-shrink: 0;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
  }
  .brand-text small {
    font-size: 0.72rem;
    color: var(--sea-light);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Hamburger button — hidden on desktop */
  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .hamburger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--sea-dark);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  nav > ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }
  nav > ul > li > a,
  nav > ul > li > button {
    text-decoration: none;
    color: var(--slate);
    font-weight: 500;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
    font: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  nav > ul > li > a:hover,
  nav > ul > li > button:hover {
    color: var(--sea);
  }
  nav > ul > li > a.active,
  nav > ul > li > button.active {
    color: var(--sea-dark);
    border-bottom-color: var(--coral);
  }
  .caret {
    font-size: 0.7em;
    transition: transform 0.15s ease;
    display: inline-block;
  }
  .has-dropdown > button[aria-expanded="true"] .caret {
    transform: rotate(180deg);
  }
  .has-dropdown {
    position: relative;
  }
  .dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 0;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.4rem;
    min-width: 240px;
    box-shadow: 0 12px 36px rgba(8, 50, 58, 0.15);
    list-style: none;
    margin: 0;
    z-index: 100;
    flex-direction: column;
  }
  .has-dropdown > button[aria-expanded="true"] ~ .dropdown {
    display: flex;
  }
  .dropdown li { padding: 0; }
  .dropdown a {
    display: block;
    padding: 0.55rem 0.8rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--slate);
    font-weight: 500;
    border-bottom: none;
  }
  .dropdown a:hover {
    background: var(--sand);
    color: var(--sea-dark);
  }
  .dropdown a.active {
    background: var(--sand);
    color: var(--sea-dark);
  }

  /* Mobile breakpoint */
  @media (max-width: 760px) {
    .hamburger {
      display: flex;
    }
    .brand-text small {
      display: none;
    }
    #primary-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 12px 24px rgba(8, 50, 58, 0.08);
      padding: 0.5rem 1.25rem 1.25rem;
    }
    .site-header.menu-open #primary-nav {
      display: block;
    }
    nav > ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    nav > ul > li {
      border-bottom: 1px solid var(--line);
    }
    nav > ul > li:last-child {
      border-bottom: none;
    }
    nav > ul > li > a,
    nav > ul > li > button {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      padding: 0.9rem 0;
      border-bottom: none;
    }
    nav > ul > li > a.active,
    nav > ul > li > button.active {
      color: var(--sea-dark);
      border-bottom: none;
      position: relative;
    }
    nav > ul > li > a.active::before,
    nav > ul > li > button.active::before {
      content: '';
      position: absolute;
      left: -1.25rem;
      top: 0.9rem;
      bottom: 0.9rem;
      width: 3px;
      background: var(--coral);
      border-radius: 0 2px 2px 0;
    }
    .dropdown {
      position: static;
      box-shadow: none;
      border: none;
      padding: 0 0 0.5rem 1rem;
      background: transparent;
      min-width: 0;
    }
    .dropdown a {
      padding: 0.6rem 0;
      font-size: 0.95rem;
      color: var(--slate);
    }
    .dropdown a.active {
      background: transparent;
    }
  }
</style>
